{
  "name": "pulsefit",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "predev": "node --env-file-if-exists=.env scripts/env-check.js",
    "dev": "concurrently -k -n api,web -c cyan,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:api": "node --watch-path=api --watch-path=server --env-file-if-exists=.env server/dev-api.js",
    "build": "vite build",
    "preview": "vite preview",
    "db:setup": "node --env-file-if-exists=.env scripts/db-setup.js"
  },
  "dependencies": {
    "@neon/config": "^1.9.4",
    "@neon/env": "^1.6.5",
    "@vercel/functions": "^3.10.3",
    "bcryptjs": "^3.0.3",
    "canvas-confetti": "^1.9.4",
    "framer-motion": "^14.6.0",
    "jose": "^6.2.13",
    "lucide-react": "^1.61.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "express": "^5.3.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.5"
  }
}
